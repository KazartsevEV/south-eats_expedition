  "objects": [
    {
      "id": "kh:royal-palace-phnom-penh",
      "name": "Royal Palace Phnom Penh",
      "object_type": "palace",
      "narrow": "Королевский дворец формирует политический и церемониальный центр Пномпень после переноса столицы из Удонг в XIX веке. Комплекс — действующая королевская резиденция, поэтому туристический доступ подчинён государственным церемониям, а не музейному расписанию.",
      "detail_path": "countries/cambodia/objects/royal-palace-phnom-penh.json"
    },
    {
      "id": "kh:tuol-sleng-genocide-museum",
      "name": "Tuol Sleng Genocide Museum",
      "object_type": "museum",
      "narrow": "Туол-Сленг — бывшая школа, превращённая режимом красные кхмеры в тюрьму и центр допросов S-21 в 1975–1979 годах. Его сила именно в сохранённой повседневной архитектуре школы, переоборудованной под заключение, документах и свидетельствах, а не в эффектной “страшной” визуальности.",
      "detail_path": "countries/cambodia/objects/tuol-sleng-genocide-museum.json"
    },
    {
      "id": "kh:choeung-ek",
      "name": "Choeung Ek",
      "object_type": "memorial_site",
      "narrow": "Чоенг-Эк — мемориальный комплекс на месте одного из массовых захоронений, куда заключённых S-21 вывозили из Пномпень. Сегодня пространство организовано вокруг памятной ступы, дорожки по территории бывших захоронений и интерпретации преступлений красные кхмеры.",
      "detail_path": "countries/cambodia/objects/choeung-ek.json"
    },
    {
      "id": "kh:oudong",
      "name": "Oudong",
      "object_type": "religious_site",
      "narrow": "Удонг был королевской столицей Камбоджа с начала XVII до XIX века и располагался между священной горой и водным путём Тонлесап — типовая для кхмерских столиц связка горы, воды и политического центра.",
      "detail_path": "countries/cambodia/objects/oudong.json"
    }
  ]
