  "objects": [
    {
      "id": "la:wat-phou",
      "name": "Wat Phou",
      "object_type": "archaeological_site",
      "narrow": "Ват-Пху — ядро 1000-летнего культурного ландшафта Champasak, где храмовая ось тянется от равнины Меконга к горе Phou Kao. Комплекс развивался с V по XV век и особенно связан с кхмерской традицией; планировка сознательно соединяет воду, дорогу, террасы и гору.",
      "detail_path": "countries/laos/objects/wat-phou.json"
    },
    {
      "id": "la:si-phan-don-4000-islands",
      "name": "Si Phan Don / 4000 Islands",
      "object_type": "island",
      "narrow": "Си-Фан-Дон — расширенная пойма Меконга перед камбоджийской границей, где в сухой сезон проявляются сотни островов, рукавов и песчаных кос. Французская колониальная железная дорога Don Det–Don Khon была инженерным обходом непроходимых порогов и водопадов Меконг.",
      "detail_path": "countries/laos/objects/si-phan-don-4000-islands.json"
    },
    {
      "id": "la:bolaven-plateau",
      "name": "Bolaven Plateau",
      "object_type": "plateau",
      "narrow": "плато Болавен — приподнятое вулканическое плато к востоку от Паксе, известное более прохладным влажным климатом, водопадами и кофейными плантациями. Французское коммерческое кофейное наследие наложилось на земли Mon-кхмерский народов, включая Laven, Katu и Alak.",
      "detail_path": "countries/laos/objects/bolaven-plateau.json"
    }
