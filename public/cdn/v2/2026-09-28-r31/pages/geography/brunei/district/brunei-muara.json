  "objects": [
    {
      "id": "bn:berakas-forest-recreational-park",
      "name": "Berakas Forest Recreational Park",
      "object_type": "natural_landscape",
      "narrow": "Прибрежный рекреационный парк, где тёмный лес резко открывается к светлому берегу Южно-Китайского моря. Интереснее переход между средами, чем отдельная 'достопримечательность'.",
      "detail_path": "countries/brunei/objects/berakas-forest-recreational-park.json"
    },
    {
      "id": "bn:omar-ali-saifuddien-mosque",
      "name": "Omar Ali Saifuddien Mosque",
      "object_type": "religious_site",
      "narrow": "Открытая в 1958 году мечеть султана Омара Али Сайфуддина III — главный архитектурный символ послевоенного Брунея. Белый мрамор, золочёный купол, искусственная лагуна и церемониальная баржа превращают её в визуальный манифест исламской монархии, а не просто отдельный культовый объект.",
      "detail_path": "countries/brunei/objects/omar-ali-saifuddien-mosque.json"
    },
    {
      "id": "bn:jame-asr-hassanil-bolkiah-mosque",
      "name": "Jame' Asr Hassanil Bolkiah Mosque",
      "object_type": "religious_site",
      "narrow": "Открытая в 1994 году государственная мечеть эпохи султана Хассанала Болкиаха. 29 золотых куполов отсылают к нынешнему султану как 29-му правителю династии; архитектура работает масштабом, симметрией и повтором.",
      "detail_path": "countries/brunei/objects/jame-asr-hassanil-bolkiah-mosque.json"
    },
    {
      "id": "bn:royal-regalia-museum",
      "name": "Royal Regalia Museum",
      "object_type": "museum",
      "narrow": "Музей придворной символики и официальной памяти о монархии: коронационные регалии, колесницы, подарки и юбилейные материалы показывают, как власть оформляется в церемонию и визуальный ритуал.",
      "detail_path": "countries/brunei/objects/royal-regalia-museum.json"
    },
    {
      "id": "bn:tasek-lama-park",
      "name": "Tasek Lama Park",
      "object_type": "forest",
      "narrow": "Лесной парк почти у центра столицы: за несколько минут городской пейзаж сменяется ручьями, корнями, крутыми тропами и обзорными точками.",
      "detail_path": "countries/brunei/objects/tasek-lama-park.json"
    },
    {
      "id": "bn:tamu-kianggeh",
      "name": "Tamu Kianggeh",
      "object_type": "market",
      "narrow": "Старый городской рынок у Kianggeh река с овощами, специями, рыбой, фруктами, готовой едой и бытовыми товарами. Он расположен в туристическом центре, но обслуживает прежде всего повседневную жизнь.",
      "detail_path": "countries/brunei/objects/tamu-kianggeh.json"
    },
    {
      "id": "bn:kampong-ayer",
      "name": "Kampong Ayer",
      "object_type": "living_settlement",
      "narrow": "Кампонг-Айер — сеть водных деревень на сваях вдоль Бруней река. Европейские путешественники описывали огромный водный город здесь уже в XVI веке; сегодня это жилые кварталы со школами, мечетями, пожарной и полицейской инфраструктурой.",
      "detail_path": "countries/brunei/objects/kampong-ayer.json"
    },
    {
      "id": "bn:malay-technology-museum",
      "name": "Malay Technology Museum",
      "object_type": "museum",
      "narrow": "Музей традиционных технологий и материальной культуры: водные поселения, ремёсла, строительство, обработка материалов и хозяйственные практики. Удобен как объясняющий объект перед Кампонг-Айер и внутренними районами.",
      "detail_path": "countries/brunei/objects/malay-technology-museum.json"
    },
    {
      "id": "bn:brunei-river-mangrove-safari",
      "name": "Brunei River Mangrove Safari",
      "object_type": "mangrove",
      "narrow": "Речной маршрут соединяет центр столицы, Кампонг-Айер и мангровые рукава, где ищут носачей, крокодилов, птиц и вечером светлячков. Это один из сильнейших способов связать городской и природный Бруней в одной сцене.",
      "detail_path": "countries/brunei/objects/brunei-river-mangrove-safari.json"
    },
    {
      "id": "bn:bukit-shahbandar-recreational-park",
      "name": "Bukit Shahbandar Recreational Park",
      "object_type": "forest",
      "narrow": "Тренировочный лесной парк с серией крутых подъёмов и спусков, популярный у местных. Характер места создаёт ритм холмов, лестниц и леса, а не одна панорамная точка.",
      "detail_path": "countries/brunei/objects/bukit-shahbandar-recreational-park.json"
    }
  ],
