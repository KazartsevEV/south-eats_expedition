  "objects": [
    {
      "id": "kh:royal-palace-phnom-penh",
      "name": "Royal Palace Phnom Penh",
      "object_type": "palace",
      "narrow": "Королевский дворец формирует политический и церемониальный центр Пномпеня после переноса столицы из Удонга в XIX веке. Комплекс остаётся действующей королевской резиденцией, поэтому доступ зависит от государственных церемоний.",
      "detail_path": "countries/cambodia/objects/royal-palace-phnom-penh.json"
    },
    {
      "id": "kh:tuol-sleng-genocide-museum",
      "name": "Tuol Sleng Genocide Museum",
      "object_type": "museum",
      "narrow": "Туол-Сленг — бывшая школа, превращённая режимом красных кхмеров в тюрьму и центр допросов S-21 в 1975–1979 годах. Сохранившаяся школьная архитектура, камеры, документы и свидетельства показывают механизм репрессий без необходимости превращать место в «страшный аттракцион».",
      "detail_path": "countries/cambodia/objects/tuol-sleng-genocide-museum.json"
    },
    {
      "id": "kh:choeung-ek",
      "name": "Choeung Ek",
      "object_type": "memorial_site",
      "narrow": "Чоенг-Эк — мемориальный комплекс на месте массовых захоронений, куда заключённых S-21 вывозили из Пномпеня. Сегодня пространство организовано вокруг памятной ступы, дорожек по территории бывших захоронений и документальной интерпретации преступлений красных кхмеров.",
      "detail_path": "countries/cambodia/objects/choeung-ek.json"
    }
  ],
