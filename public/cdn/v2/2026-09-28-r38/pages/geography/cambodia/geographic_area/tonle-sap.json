  "objects": [
    {
      "id": "kh:tonle-sap-biosphere-reserve",
      "name": "Tonle Sap Biosphere Reserve",
      "object_type": "wetland",
      "narrow": "Тонлесап — сезонно пульсирующая система озера, реки, поймы и затопляемого леса. Поселения, рыболовство, причалы и маршруты физически меняются вместе с уровнем воды, поэтому «плавучая деревня» не должна описываться как статичная декорация.",
      "detail_path": "countries/cambodia/objects/tonle-sap-biosphere-reserve.json"
    }
  ],
