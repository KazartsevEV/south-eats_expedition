  "objects": [
    {
      "id": "kh:preah-vihear",
      "name": "Preah Vihear",
      "object_type": "archaeological_site",
      "narrow": "Преахвихеа — храм Шивы, развивавшийся с IX по XII век на краю уступа Дангрэк. В отличие от концентрического Ангкор-Вата ансамбль вытянут по оси вдоль хребта и террас: рельеф формирует последовательный ритуальный путь вверх.",
      "detail_path": "countries/cambodia/objects/preah-vihear.json"
    },
    {
      "id": "kh:koh-ker",
      "name": "Koh Ker",
      "object_type": "archaeological_site",
      "narrow": "Кох-Кер был столичным центром Кхмерской империи в X веке при Джаявармане IV. Город, известный как Лингапура или Чок-Гаргьяр, формировался быстро и выделяется крупной каменной скульптурой, монументальными лингамами и ступенчатой пирамидой Прасат-Пранг.",
      "detail_path": "countries/cambodia/objects/koh-ker.json"
    },
    {
      "id": "kh:preah-khan-kompong-svay",
      "name": "Preah Khan Kompong Svay",
      "object_type": "archaeological_site",
      "narrow": "Преах-Кхан-Компонг-Свай, исторически Бакан, — крупный удалённый комплекс к востоку от Ангкора. ЮНЕСКО описывает его как махаянский город, узел восточной королевской дороги и район, связанный с производством железа.",
      "detail_path": "countries/cambodia/objects/preah-khan-kompong-svay.json"
    }
  ],
