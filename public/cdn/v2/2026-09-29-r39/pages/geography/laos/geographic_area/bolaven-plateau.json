  "objects": [
    {
      "id": "la:bolaven-plateau",
      "name": "Bolaven Plateau",
      "object_type": "plateau",
      "narrow": "плато Болавен — приподнятое вулканическое плато к востоку от Паксе, известное более прохладным влажным климатом, водопадами и кофейными плантациями. Французское коммерческое кофейное наследие наложилось на земли Mon-кхмерский народов, включая Laven, Katu и Alak.",
      "detail_path": "countries/laos/objects/bolaven-plateau.json"
    }
  ],
