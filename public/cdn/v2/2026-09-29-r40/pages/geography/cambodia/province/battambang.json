    "languages": {
      "spoken": [
        "кхмерский",
        "английский в туристической сфере",
        "тайский иногда понимают"
      ],
      "notes": "Практический полевой профиль: перечислены языки, которые реально вероятно встретить путешественнику в регионе; не полный перечень всех этнолингвистических групп."
    },
    "climate": {
      "summary": "Жаркая низменность с выраженным дождливым сезоном.",
      "rainfall_pattern": "Основная сезонность определяется северо-восточным сухим и юго-западным дождливым муссонами; локальная интенсивность осадков резко различается между равниной, побережьем и Кардамоновыми горами.",
      "field_context": "Сильные дожди прежде всего меняют состояние сельских дорог и грунтовых подъездов.",
      "source_refs": [
        "src_900013"
      ],
      "best_period_general": "Ноябрь–февраль."
    },
    "geography": {
      "summary": "Город расположен на реке Сангкер в западной низменной части страны; сельская периферия связана с рисовыми равнинами и дорогами к северо-западной границе.",
      "source_refs": [
        "src_900013"
      ]
    },
    "relief": {
      "summary": "Преимущественно плоская сельскохозяйственная равнина с отдельными известняковыми и скальными возвышенностями вокруг города."
    },
    "hydrology": {
      "river": "Сангкер — главная городская водная ось; сезонный уровень воды влияет на набережную и сельские пойменные участки."
    },
    "health": {
      "malaria": {
        "current_context": "По данным ВОЗ, в 2025 году в Камбодже зарегистрировано 107 случаев малярии; программа находится на этапе элиминации и предотвращения восстановления местной передачи.",
        "field_context": "Не переносить страновой показатель на конкретный городской или сельский район без локальных данных."
