  "objects": [
    {
      "id": "kh:angkor-archaeological-park",
      "name": "Angkor Archaeological Park",
      "object_type": "archaeological_site",
      "narrow": "Ангкор — не один храм, а огромный культурный ландшафт бывших столиц Кхмерской империи: храмы, дороги, дамбы, каналы, бараи, монастыри, деревни и сельскохозяйственные земли образуют единую систему.",
      "detail_path": "countries/cambodia/objects/angkor-archaeological-park.json"
    },
    {
      "id": "kh:beng-mealea",
      "name": "Beng Mealea",
      "object_type": "archaeological_site",
      "narrow": "Бенг-Мелеа — крупный храмовый комплекс XII века на древней восточной дорожной системе Ангкора, архитектурно близкий к Ангкор-Вату и сильно разрушенный.",
      "detail_path": "countries/cambodia/objects/beng-mealea.json"
    },
    {
      "id": "kh:phnom-kulen-national-park",
      "name": "Phnom Kulen National Park",
      "object_type": "national_park",
      "narrow": "Пном-Кулен — песчаниковое плато к северо-востоку от Ангкора, где в начале IX века формировался Махендрапарвата и ранняя политико-религиозная программа Кхмерской империи.",
      "detail_path": "countries/cambodia/objects/phnom-kulen-national-park.json"
    }
  ],
