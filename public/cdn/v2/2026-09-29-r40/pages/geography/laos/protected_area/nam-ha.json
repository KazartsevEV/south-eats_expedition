  "objects": [
    {
      "id": "la:nam-ha-national-protected-area",
      "name": "Nam Ha National Protected Area",
      "object_type": "protected_area",
      "narrow": "Нам-Ха — охраняемая горно-лесная зона вокруг Луангнамтха, где треккинг-схема строится вокруг леса и деревень Khmu, Akha, Lanten, Hmong, Tai Dam/Tai Lue и других групп. Важная часть модели — обязательный/организованный местный гид и местное сообщество ночёвки.",
      "detail_path": "countries/laos/objects/nam-ha-national-protected-area.json"
    }
  ],
