  "objects": [
    {
      "id": "la:kong-lor-cave",
      "name": "Kong Lor Cave",
      "object_type": "cave",
      "narrow": "Конг-Лор — сквозная карстовая пещера с подземной рекой Нам-Хин-Бун, по которой лодка проходит несколько километров под массивом. Главное впечатление создаёт не украшенная часть с подсветкой, а масштаб тёмного речного тоннеля и выход в долину Natan.",
      "detail_path": "countries/laos/objects/kong-lor-cave.json"
    },
    {
      "id": "la:old-thakhek-town",
      "name": "Old Thakhek Town",
      "object_type": "historic_city",
      "narrow": "Старый Тхакхэк — компактный квартал на Меконг с франко-лаосскими шопхаусами, католическим и буддийским слоями и ролью транзитного центра к карсту Кхаммуан. Для экспедиции он работает как человеческая прелюдия к кольцевой маршрут Тхакхэка и Конг-Лор.",
      "detail_path": "countries/laos/objects/old-thakhek-town.json"
