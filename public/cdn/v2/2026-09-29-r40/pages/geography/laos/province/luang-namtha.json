  "objects": [
    {
      "id": "la:nam-ha-national-protected-area",
      "name": "Nam Ha National Protected Area",
      "object_type": "protected_area",
      "narrow": "Нам-Ха — охраняемая горно-лесная зона вокруг Луангнамтха, где треккинг-схема строится вокруг леса и деревень Khmu, Akha, Lanten, Hmong, Tai Dam/Tai Lue и других групп. Важная часть модели — обязательный/организованный местный гид и местное сообщество ночёвки.",
      "detail_path": "countries/laos/objects/nam-ha-national-protected-area.json"
    },
    {
      "id": "la:muang-sing-market-and-tai-lue-cultural-landscape",
      "name": "Muang Sing market and Tai Lue cultural landscape",
      "object_type": "cultural_landscape",
      "narrow": "Мыанг-Синг — высокогорная долина у китайской границы, исторически связанная с Tai Lue княжествами и торговыми маршрутами. Утренний рынок собирает Lao, Tai Lue, Akha, Hmong и другие группы региона; окружающий ландшафт — рисовые поля, деревни и небольшие буддийские ваты.",
      "detail_path": "countries/laos/objects/muang-sing-market-and-tai-lue-cultural-landscape.json"
    }
