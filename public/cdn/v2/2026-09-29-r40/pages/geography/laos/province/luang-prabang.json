  "objects": [
    {
      "id": "la:luang-prabang",
      "name": "Luang Prabang",
      "object_type": "historic_city",
      "narrow": "Луангпхабанг — бывшая королевская столица Лансанга и затем королевства Луангпхабанг, исторический город на полуострове между Меконгом и Нам-Кханом.",
      "detail_path": "countries/laos/objects/luang-prabang.json"
    },
    {
      "id": "la:nong-khiaw-and-muang-ngoi",
      "name": "Nong Khiaw and Muang Ngoi",
      "object_type": "karst",
      "narrow": "Нонг-Кхиав и Мыанг-Нгой — связка поселений в узкой долине Нам-У между высокими известняковыми стенами. Нонг-Кхиав — дорожный узел и база, Мыанг-Нгой исторически был доступен в первую очередь по реке и сохраняет более выраженный речной ритм.",
      "detail_path": "countries/laos/objects/nong-khiaw-and-muang-ngoi.json"
    },
    {
      "id": "la:kuang-si-falls",
      "name": "Kuang Si Falls",
      "object_type": "waterfall",
      "narrow": "Куанг-Си — каскад по известняковым/травертиновым уступам южнее Луангпхабанг. Бирюзовый цвет создаётся рассеянием света в минеральной воде; визуальный интерес — последовательность малых чаш, леса и главного вертикального водопада, а не один бассейн.",
      "detail_path": "countries/laos/objects/kuang-si-falls.json"
    },
    {
      "id": "la:pak-ou-caves",
      "name": "Pak Ou Caves",
      "object_type": "cave",
      "narrow": "Пак-У — две пещеры в известняковой стене над Меконг у устья Нам-У, заполненные тысячами буддийских изображений разных размеров и периодов. Сюжет — одновременно паломничество, накопление вотивных образов и речная география.",
      "detail_path": "countries/laos/objects/pak-ou-caves.json"
    }
  ],
