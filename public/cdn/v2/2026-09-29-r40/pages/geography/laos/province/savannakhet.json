    "languages": {
      "spoken": [
        "лаосский",
        "тайский часто понимают",
        "встречается вьетнамский язык",
        "английский ограниченно используется в туристической сфере"
      ],
      "notes": "Практический полевой профиль: перечислены языки, которые реально вероятно встретить путешественнику в регионе; не полный перечень всех этнолингвистических групп."
    },
    "climate": {
      "summary": "Тропический муссонный климат с выраженным сухим и дождливым сезонами; высота сильно меняет температуру и туманность.",
      "rainfall_pattern": "Основная часть осадков приходится на летний муссон; в горных и карстовых районах локальные ливни сильнее влияют на дороги, реки и пещеры.",
      "field_context": "В сухой сезон пешая работа проще; летом жара и ливни сильнее влияют на дороги и набережную.",
      "source_refs": [
        "src_000499"
      ],
      "best_period_general": "Ноябрь–февраль для пешего старого города."
    },
    "geography": {
      "summary": "Низменный город и провинциальный узел на левом берегу Меконга, связанный с восточно-западным сухопутным коридором в Таиланд и Вьетнам.",
      "source_refs": [
        "src_902001"
      ]
    },
    "relief": {
      "summary": "Преимущественно плоская низменность Меконга."
    },
    "hydrology": {
      "river": "Меконг",
      "monitoring": "MRC включает Саваннакхет в сеть наблюдений нижнего Меконга.",
      "source_refs": [
        "src_902001"
      ]
    },
    "health": {
      "malaria": {
        "current_context": "Лаос остаётся в перечне стран, по которым ВОЗ ведёт ежегодный малярийный профиль.",
        "field_context": "Страновой показатель не является оценкой риска конкретного города или долины."
