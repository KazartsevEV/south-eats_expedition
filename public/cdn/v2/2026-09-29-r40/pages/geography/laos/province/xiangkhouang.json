  "objects": [
    {
      "id": "la:plain-of-jars",
      "name": "Plain of Jars",
      "object_type": "megalithic_site",
      "narrow": "Равнина Кувшинов — серия мегалитических полей железного века в Сиангкхуанг: тысячи каменных сосудов, дисков и связанных погребальных следов разбросаны по плато. Археологическая интерпретация связывает комплексы с погребальной практикой и дальними путями обмена, а не с буквальным хранением напитков.",
      "detail_path": "countries/laos/objects/plain-of-jars.json"
    },
    {
      "id": "la:tham-piu-cave",
      "name": "Tham Piu Cave",
      "object_type": "cave",
      "narrow": "Тхам-Пиу — пещера и мемориал в Сиангкхуанг, связанный с гибелью мирных жителей во время войны в Индокитае. Для маршрута это не 'ещё одна пещера', а место памяти, которое объясняет, почему UXO и бомбардировки остаются частью современной географии провинции.",
      "detail_path": "countries/laos/objects/tham-piu-cave.json"
    }
  ],
