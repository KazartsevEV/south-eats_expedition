  "geography": {
    "summary": "Провинция лежит между западным побережьем Лусона и внутренними горными районами; Виган расположен в её прибрежной равнинной части.",
    "source_refs": [
      "src_904051"
    ]
  },
  "history": {
    "summary": "Виган сохраняет редкую целостную испано-колониальную городскую ткань с азиатскими строительными традициями и живыми ремёслами.",
    "source_refs": [
      "src_904050"
    ]
  },
  "culture": {
    "summary": "Ilocano-культура провинции не исчерпывается Виганом; городской heritage-слой следует отделять от сельского и горного контекста.",
    "source_refs": [
      "src_904050",
      "src_904051"
    ]
  },
  "transport": {
    "summary": "Провинция связана северо-западным шоссе Лусона; Vigan удобен как городской хаб, но горные и удалённые муниципалитеты требуют отдельных наземных перегонов.",
    "source_refs": [
      "src_904050"
    ]
  },
  "climate": {
    "summary": "Жаркий тропический климат северо-западного Лусона с выраженной сезонностью дождей; побережье и горные районы отличаются по ветру и температуре.",
    "source_refs": [
