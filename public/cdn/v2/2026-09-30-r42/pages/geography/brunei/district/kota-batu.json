    "geography": {
      "summary": "Mukim Kota Batu подтверждается как отдельная административная единица Бруней-Муара в государственных зональных и картографических материалах.",
      "source_refs": [
        "src_910031",
        "src_910035"
      ]
    },
    "transport": {
      "summary": "Для самостоятельной логистики mukim связан с дорожной сетью столичного района; конкретные подъезды к музеям, причалам и речным точкам должны храниться ниже — на уровне объекта или маршрута.",
      "source_refs": [
        "src_910031",
        "src_910034"
      ]
    },
    "climate": {
      "summary": "Экваториальный жаркий и влажный климат следует общему режиму Брунея; сильные ливни могут менять дорожные и речные условия.",
      "source_refs": [
        "src_000746"
      ]
    },
    "freshness": {
      "checked_at": "2026-10-01"
    }
  },
