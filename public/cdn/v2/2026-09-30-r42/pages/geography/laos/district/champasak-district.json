  "objects": [
    {
      "id": "la:wat-phou",
      "name": "Wat Phou",
      "object_type": "archaeological_site",
      "narrow": "Ват-Пху — ядро 1000-летнего культурного ландшафта Champasak, где храмовая ось тянется от равнины Меконга к горе Phou Kao. Комплекс развивался с V по XV век и особенно связан с кхмерской традицией; планировка сознательно соединяет воду, дорогу, террасы и гору.",
      "detail_path": "countries/laos/objects/wat-phou.json"
    }
  ],
