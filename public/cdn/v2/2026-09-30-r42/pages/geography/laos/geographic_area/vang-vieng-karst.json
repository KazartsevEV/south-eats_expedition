  "objects": [
    {
      "id": "la:vang-vieng-karst",
      "name": "Vang Vieng karst",
      "object_type": "karst",
      "narrow": "Ванг-Вьенг лежит в долине Нам-Сонг под почти вертикальными башнями тропического известнякового карста. Туризм здесь вырос из речных и пещерных маршрутов, но главный сюжет — взаимодействие реки, рисовых полей и карстовых массивов, а не отдельная Голубая лагуна.",
      "detail_path": "countries/laos/objects/vang-vieng-karst.json"
    }
  ],
