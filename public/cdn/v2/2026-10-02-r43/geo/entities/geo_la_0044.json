  "geography": {
    "summary": "Охраняемая территория Нам-Ха занимает горно-лесной ландшафт вокруг основных маршрутных направлений Луангнамтхи.",
    "source_refs": [
      "src_902011"
    ]
  },
  "ethnography": {
    "summary": "Маршруты проходят через многоэтничные деревни; культурные сведения должны привязываться к конкретным общинам, а не подаваться как абстрактный «hill tribe experience».",
    "source_refs": [
      "src_902011"
    ]
  },
  "transport": {
    "summary": "Базовый узел — Luang Namtha; дальше используются локальные дороги и пешие маршруты. Для сложных лесных маршрутов местный проводник рационален из-за навигации, общинного доступа и режима охраняемой территории.",
    "source_refs": [
      "src_902011"
    ]
  },
  "climate": {
    "summary": "В сезон дождей грязь и размывы резко уменьшают реальный дневной километраж; сухие прохладные месяцы удобнее для многодневных маршрутов.",
    "source_refs": [
      "src_902002",
      "src_902011"
    ]
  },
  "freshness": {
    "checked_at": "2026-10-01"
  },
  "languages": {
    "spoken": [
      "лаосский",
      "кхму, акха, лантен/мун и другие языки общин провинции",
