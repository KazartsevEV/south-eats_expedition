    "geography": {
      "summary": "Район расположен на западной стороне Меконга в провинции Чампасак и включает культурный ландшафт Ват-Пху и прилегающие поселения.",
      "source_refs": [
        "src_902016"
      ]
    },
    "transport": {
      "summary": "Доступ наземный из Pakse/Champasak; конкретные входы Ват-Пху и других объектов должны храниться отдельно от районного центра.",
      "source_refs": [
        "src_902016"
      ]
    },
    "climate": {
      "summary": "Низменный южнолаосский муссонный климат; сильные дожди влияют на состояние локальных дорог и лестничных участков культурного ландшафта.",
      "source_refs": [
        "src_902002"
      ]
    },
    "freshness": {
      "checked_at": "2026-10-01"
    },
    "languages": {
      "spoken": [
        "Lao",
        "English in tourism",
        "лавен, алак, кату и другие мон-кхмерские языки на плато"
