      ],
      "region_legacy": "Хуапхан / Луангпхабанг / Сиангкхуанг",
      "nearest_hub": "Мыанг-Хиам (Muang Hiam)",
      "narrow": "Нам-Эт — Пху-Луэй — огромный горный национальный парк северо-восточного Лаоса, где самостоятельность заканчивается не у турфирмы, а у режима охраняемой территории: до Мыанг-Хиама или Ban Son Khoua добираются своим ходом, дальше работают официальные речные и многодневные горные маршруты с гидом парка и местными командами.",
      "detail_path": "countries/laos/objects/nam-et-phou-louey-area.json"
    },
    {
      "id": "la:nam-ha-national-protected-area",
      "name": "Nam Ha National Protected Area",
      "geography_ids": [
        "country:la",
        "la:protected-area:nam-ha",
        "la:province:luang-namtha"
      ],
      "region_legacy": "Луангнамтха / Нам-Ха",
      "nearest_hub": "Луангнамтха",
      "narrow": "Нам-Ха — 222 400 га горных лесов и водосборов Луангнамтха, где охрана природы с конца 1990-х связана с общинным экотуризмом. Для экспедиции это не «пакетный трек», а сочетание регулируемых многодневных маршрутов, рек, леса и деревень с отдельными самостоятельно доступными дорожными точками; режим конкретного трека нужно проверять до выхода.",
      "detail_path": "countries/laos/objects/nam-ha-national-protected-area.json"
    },
