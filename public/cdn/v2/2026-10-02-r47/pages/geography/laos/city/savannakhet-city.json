  "objects": [
    {
      "id": "la:savannakhet-old-quarter",
      "name": "Savannakhet old quarter",
      "object_type": "historic_city",
      "narrow": "Старый Саваннакхет — редкий для Лаоса компактный исторический городской ансамбль, где колониальная и арт-деко архитектура существует внутри действующей многоэтничной среды. Здесь важны не отдельные «французские дома», а сетка улиц, рынки, храмы, кинотеатры и Меконг как единая городская система.",
      "detail_path": "countries/laos/objects/savannakhet-old-quarter.json"
    },
    {
      "id": "la:savannakhet-dinosaur-museum",
      "name": "Savannakhet Dinosaur Museum",
      "object_type": "museum",
      "narrow": "Музей динозавров в Саваннакхете, самостоятельный научно-музейный объект и не часть архитектурной карточки старого квартала.",
      "detail_path": "countries/laos/objects/savannakhet-dinosaur-museum.json"
    },
