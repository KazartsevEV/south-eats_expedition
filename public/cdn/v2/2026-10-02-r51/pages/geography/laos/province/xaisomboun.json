  "objects": [
    {
      "id": "la:phou-khao-khouay-national-park",
      "name": "Phou Khao Khouay National Park",
      "object_type": "national_park",
      "narrow": "Пху-Кхао-Кхуай — большой национальный парк рядом с Вьентьяном, но на земле он распадается на несколько удалённых секторов. Для самостоятельной экспедиционной логики особенно полезен Тад-Леук: сюда ведёт отдельная дорога, есть visitor center, официальный кемпинг и короткая самостоятельная природная тропа. Из Бан-Хаткхая начинаются уже другие, регулируемые местными проводниками маршруты к Тад-Сай/Пха-Сай и на песчаниковые плато.",
      "detail_path": "countries/laos/objects/phou-khao-khouay-national-park.json"
    },
    {
      "id": "la:chao-anouvong-cave",
      "name": "Chao Anouvong Cave",
      "object_type": "cave",
      "narrow": "Пещерный объект у Anouvong Town, связанный в местной исторической традиции с бегством короля Анувонга; документирован отдельной карточкой Tourism Laos.",
      "detail_path": "countries/laos/objects/chao-anouvong-cave.json"
    },
    {
      "id": "la:tad-poung-waterfall",
      "name": "Tad Poung Waterfall",
      "object_type": "waterfall",
      "narrow": "Двухступенчатый водопад в горном Сайсомбуне, перечисленный Tourism Laos как самостоятельный природный объект.",
      "detail_path": "countries/laos/objects/tad-poung-waterfall.json"
    },
    {
      "id": "la:tad-houay-nok-waterfall",
      "name": "Tad Houay Nok Waterfall",
      "object_type": "waterfall",
      "narrow": "Высокий водопад в окрестностях Anouvong Town, который официальный Tourism Laos отмечает как круглогодичный рекреационный объект.",
      "detail_path": "countries/laos/objects/tad-houay-nok-waterfall.json"
    },
    {
      "id": "la:phou-bia",
      "name": "Phou Bia",
      "object_type": "natural_landscape",
      "narrow": "Высочайшая вершина Лаоса в Сайсомбуне; включена в инвентарь как отдельный горный объект, но режим доступа должен быть проверен до публикации практической логистики.",
