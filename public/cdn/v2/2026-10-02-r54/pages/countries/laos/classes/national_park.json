    {
      "id": "la:hin-nam-no-national-park",
      "name": "Hin Nam No National Park",
      "geography_ids": [
        "country:la",
        "la:district:boualapha",
        "la:protected-area:hin-nam-no",
        "la:province:khammouane"
      ],
      "region_legacy": "Кхаммуан / Буалапа",
      "nearest_hub": "Буалапа / Нонг-Пинг",
      "narrow": "Хин-Нам-Но — крупный карстовый национальный парк на востоке Кхаммуана, соединённый через границу с вьетнамским Фонгня-Кебангом в единый трансграничный объект Всемирного наследия. Экспедиционно это не одна точка, а система известняковых плато, речных пещер, лесов и деревенских маршрутов; наиболее понятный самостоятельный вход в парк — район Нонг-Пинг и пещеры Се-Банг-Фай.",
      "detail_path": "countries/laos/objects/hin-nam-no-national-park.json"
    },
    {
      "id": "la:nakai-nam-theun-national-park",
      "name": "Nakai Nam Theun National Park",
      "geography_ids": [
        "country:la",
        "la:district:nakai",
        "la:protected-area:nakai-nam-theun",
        "la:province:khammouane",
        "la:town:nakai"
      ],
      "region_legacy": "Кхаммуан / Накай–Нам-Теун",
      "nearest_hub": "Накай (Удомсук) / Тхаланг",
      "narrow": "Накай–Нам-Теун — один из крупнейших лесных массивов Аннамских гор в Лаосе: около 4 700 км² национального парка между плато Накай и вьетнамской границей, с высотами примерно 500–2300 м. Для экспедиционного маршрута он ценен не одной «точкой», а сочетанием водосборов, лесных хребтов, лодочных подходов и регулируемых многодневных треков.",
      "detail_path": "countries/laos/objects/nakai-nam-theun-national-park.json"
    },
