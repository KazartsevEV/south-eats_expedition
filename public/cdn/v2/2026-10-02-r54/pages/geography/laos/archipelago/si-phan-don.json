  "objects": [
    {
      "id": "la:si-phan-don-4000-islands",
      "name": "Si Phan Don / 4000 Islands",
      "object_type": "island",
      "narrow": "Си-Фан-Дон — разветвлённый речной ландшафт нижнего Меконга у камбоджийской границы, где острова, рукава, пороги и сезонные отмели образуют систему, а не один курорт. Его ключи — живые островные деревни, рыболовство и земледелие, огромный барьер водопадов Кхон, а также короткая колониальная железная дорога Дон-Дет–Дон-Кхон, построенная как технический обход участка Меконга, который оказался непроходим для сквозной навигации.",
      "detail_path": "countries/laos/objects/si-phan-don-4000-islands.json"
    },
    {
      "id": "la:khone-phapheng-falls",
      "name": "Khone Phapheng Falls",
      "object_type": "waterfall",
      "narrow": "Кхон-Папенг — не высокий одиночный обрыв, а гигантская система порогов и каскадов Меконга в Си-Фан-Доне. Tourism Laos указывает максимальный перепад около 21 м и участок порогов длиной около 9,7 км; именно эта система исторически разрывает сквозную навигацию по Меконгу.",
      "detail_path": "countries/laos/objects/khone-phapheng-falls.json"
    },
    {
      "id": "la:li-phi-somphamit-falls",
      "name": "Li Phi / Somphamit Falls",
      "object_type": "waterfall",
      "narrow": "Тад-Сомпхамит — пороги западного Дон-Кхона, где один из рукавов Меконга сжимается между островами и валунами. В официальной лаосской версии «Li Phi» относится не только к этому каскаду, а к более широкому примерно 20-километровому поясу порогов Си-Фан-Дона; сам водопад корректнее называть Тад-Сомпхамит.",
      "detail_path": "countries/laos/objects/li-phi-somphamit-falls.json"
    }
  ],
