  "objects": [
    {
      "id": "la:tad-fane",
      "name": "Tad Fane",
      "object_type": "waterfall",
      "narrow": "Тад-Фане — двойной водопад на западной кромке плато Болавен, где реки Чампи и Пак-Кут падают примерно на 120 м в глубокий лесной амфитеатр. Это не просто roadside viewpoint: объект лежит внутри национального парка Донг-Хуа-Сао и связан с более длинными лесными маршрутами по краю плато.",
      "detail_path": "countries/laos/objects/tad-fane.json"
    },
    {
      "id": "la:tad-yuang",
      "name": "Tad Yuang",
      "object_type": "waterfall",
      "narrow": "Тад-Юанг — компактный двойной водопад плато Болавен с падением около 40–42 м, к которому можно подойти значительно ближе, чем к соседнему Тад-Фане. Сверху устроены рынок и picnic area, а лестничная тропа спускается к среднему и нижнему viewpoints у чаши водопада.",
      "detail_path": "countries/laos/objects/tad-yuang.json"
    }
  ],
