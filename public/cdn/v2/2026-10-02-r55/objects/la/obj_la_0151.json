  "narrative": {
    "sections": [
      {
        "section_id": "history",
        "content": [
          {
            "type": "documented_history",
            "text": "Мыанг-Синг исторически связан с Tai Lue княжествами и пограничными торговыми маршрутами."
          }
        ],
        "source_refs": [
          "src_000439",
          "src_000008",
          "src_000208"
        ]
      },
      {
        "section_id": "geography",
        "content": "Это широкая межгорная котловина у китайской границы с рисовыми полями, деревнями и горным обрамлением.",
        "source_refs": [
          "src_000439",
          "src_000008",
          "src_000208"
        ]
      },
      {
        "section_id": "ethnography",
        "content": "Tai Lue и соседние группы формируют многоэтничный культурный ландшафт района; конкретные практики нельзя механически переносить между общинами.",
        "source_refs": [
          "src_000439",
          "src_000008",
          "src_000208"
        ]
      },
      {
        "section_id": "myths_beliefs",
        "content": [
          {
            "type": "local_tradition",
            "text": "В регионе сохраняются культы духов дома, деревни и предков; конкретные табу различаются между общинами."
          }
        ],
        "source_refs": [
          "src_000439",
          "src_000008",
          "src_000208"
        ]
      }
    ]
  },
