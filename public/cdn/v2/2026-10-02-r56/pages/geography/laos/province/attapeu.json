    "geography": {
      "summary": "Провинция граничит с Вьетнамом и Камбоджей. Основные реки включают Секонг, Се-Каман и Се-Су; северо-восток занимает горно-лесной массив Донг-Амфам.",
      "source_refs": [
        "src_902031"
      ]
    },
    "hydrology": {
      "summary": "Реки являются не только географической особенностью, но и частью доступа: некоторые водопады и лесные участки достигаются пешком либо на лодке по Секонгу и притокам.",
      "source_refs": [
        "src_902031"
      ]
    },
    "ethnography": {
      "summary": "Официальный обзор перечисляет в провинции алак, катанг, калым, кату, суай, нгэ, лаве, тахой и нья-хеунг; у отдельных групп сохраняются собственные ремёсла и праздничные традиции.",
      "source_refs": [
        "src_902031"
      ]
    },
    "transport": {
      "summary": "Удалённые точки востока и юга не сводятся к автомобильному подъезду: для части водопадов на Се-Пиане и Се-Су официальный источник прямо указывает пеший или лодочный доступ и использование местных проводников.",
      "source_refs": [
        "src_902031"
      ]
    },
    "climate": {
      "summary": "Низкие долины Секонга жаркие, тогда как северо-восточные высоты Донг-Амфама заметно прохладнее. В сезон дождей речной сток возрастает, грунтовые горные дороги размокают, и доступ к удалённым водопадам и Нонг-Фа становится значительно медленнее.",
      "source_refs": [
        "src_000499",
        "src_902031"
      ]
    },
    "freshness": {
      "checked_at": "2026-10-02"
    },
