      ],
      "region_legacy": "Луангпхабанг / север долины Нам-У",
      "nearest_hub": "Luang Prabang",
      "narrow": "Куанг-Си — каскад по известняковым/травертиновым уступам южнее Луангпхабанг. Бирюзовый цвет создаётся рассеянием света в минеральной воде; визуальный интерес — последовательность малых чаш, леса и главного вертикального водопада, а не один бассейн.",
      "detail_path": "countries/laos/objects/kuang-si-falls.json"
    },
    {
      "id": "la:tad-fane",
      "name": "Tad Fane",
      "geography_ids": [
        "country:la",
        "la:district:paksong",
