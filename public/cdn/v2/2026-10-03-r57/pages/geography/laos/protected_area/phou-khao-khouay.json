  "objects": [
    {
      "id": "la:phou-khao-khouay-national-park",
      "name": "Phou Khao Khouay National Park",
      "object_type": "national_park",
      "narrow": "Пху-Кхао-Кхуай — большой национальный парк рядом с Вьентьяном, но на земле он распадается на несколько удалённых секторов. Для самостоятельной экспедиционной логики особенно полезен Тад-Леук: сюда ведёт отдельная дорога, есть visitor center, официальный кемпинг и короткая самостоятельная природная тропа. Из Бан-Хаткхая начинаются уже другие, регулируемые местными проводниками маршруты к Тад-Сай/Пха-Сай и на песчаниковые плато.",
      "detail_path": "countries/laos/objects/phou-khao-khouay-national-park.json"
    },
    {
      "id": "la:tad-xai-waterfall",
      "name": "Tad Xai Waterfall",
      "object_type": "waterfall",
      "narrow": "Tad Xai — семиступенчатый водопад на ручье Houay Xay внутри Phou Khao Khouay National Park. Его ценность не в одной высокой стене, а в последовательности 1–3-метровых уступов, большой лесной чаше и песчаниковом русле среди богатого вечнозелёного леса. Соседний Pha Xay — отдельный водопад ниже по течению; их часто продают и описывают как пару, но в канонической базе смешивать их нельзя.",
      "detail_path": "countries/laos/objects/tad-xai-waterfall.json"
    },
    {
      "id": "la:tad-leuk-waterfall",
      "name": "Tad Leuk Waterfall",
      "object_type": "waterfall",
      "narrow": "Доступный водопад Phou Khao Khouay с рекреационной инфраструктурой и тропами; отдельный физический объект внутри национального парка.",
      "detail_path": "countries/laos/objects/tad-leuk-waterfall.json"
    }
  ],
